rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Central media registry: public read for streamable URLs, authenticated or guest create/update
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }
    // Secure user-specific subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /media/{mediaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}