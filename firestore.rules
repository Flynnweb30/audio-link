rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /media/{documentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}