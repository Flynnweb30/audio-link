rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write for the media registry
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }
    // Allow authenticated users to manage user documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}